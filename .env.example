# =============================================================
# IPTV Platform – Environment Variables Template
# Copy this file to .env and fill in your values
# =============================================================

# ─── Application ─────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_STRONG_SECRET_KEY_32CHARS

# ─── Backend API ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1
API_PREFIX=/api/v1

# ─── Database (PostgreSQL) ───────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iptv_platform
POSTGRES_USER=iptv_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://iptv_user:CHANGE_ME_DB_PASSWORD@postgres:5432/iptv_platform

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ─── JWT / Auth ──────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_64CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Odoo Integration ────────────────────────────────────────
ODOO_URL=https://your-odoo-instance.com
ODOO_DATABASE=your_odoo_db
ODOO_USERNAME=admin
ODOO_PASSWORD=CHANGE_ME_ODOO_PASSWORD
ODOO_API_KEY=CHANGE_ME_ODOO_API_KEY
ODOO_SYNC_INTERVAL_SECONDS=300

# ─── Ingest Service ──────────────────────────────────────────
INGEST_MULTICAST_INTERFACE=eth0
INGEST_BUFFER_SIZE=4194304
INGEST_RECONNECT_DELAY=5
INGEST_MAX_RECONNECT_ATTEMPTS=10
INGEST_PCR_MONITORING=true
INGEST_STATS_INTERVAL=10
INGEST_API_PORT=8001

# ─── Transcoder Service ──────────────────────────────────────
TRANSCODER_API_PORT=8002
TRANSCODER_GPU_INDEX=0
TRANSCODER_NVENC_PRESET=p4
TRANSCODER_NVENC_TUNE=ll
TRANSCODER_MAX_CONCURRENT_JOBS=8
TRANSCODER_HW_DECODE=true
TRANSCODER_ZERO_COPY=true
TRANSCODER_OUTPUT_PATH=/streams/transcoded
FFMPEG_BINARY=/usr/bin/ffmpeg

# ─── Packager Service ────────────────────────────────────────
PACKAGER_API_PORT=8003
PACKAGER_HLS_SEGMENT_DURATION=2
PACKAGER_HLS_LIST_SIZE=6
PACKAGER_OUTPUT_PATH=/streams/hls
PACKAGER_BASE_URL=https://your-domain.com/hls
PACKAGER_RTSP_PORT=8554
PACKAGER_SRT_PORT=9000

# ─── Auth Service ────────────────────────────────────────────
AUTH_API_PORT=8004

# ─── Nginx ───────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_DOMAIN=your-domain.com

# ─── Monitoring ──────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── NVIDIA ──────────────────────────────────────────────────
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
CUDA_VISIBLE_DEVICES=0

# ─── Feature Flags ───────────────────────────────────────────
ENABLE_ODOO_SYNC=true
ENABLE_EPG=true
ENABLE_ADAPTIVE_BITRATE=true
ENABLE_METRICS=true
ENABLE_AUDIT_LOG=true
