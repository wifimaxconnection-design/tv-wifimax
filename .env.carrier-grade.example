# =============================================================
# Variables adicionales para expansión carrier-grade
# Agregar al .env existente
# =============================================================

# ── IPv6 Manager ─────────────────────────────────────────────
IPV6_MGR_PORT=8010

# ── BGP Orchestrator ─────────────────────────────────────────
BGP_ORCH_PORT=8011

# ── NOC Engine ───────────────────────────────────────────────
NOC_ENGINE_PORT=8012

# ── Zabbix Sync ──────────────────────────────────────────────
ZABBIX_SYNC_PORT=8013
ZABBIX_URL=http://tu-servidor-zabbix/zabbix
ZABBIX_API_TOKEN=tu_token_zabbix
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
ZABBIX_SYNC_INTERVAL=300

# ── WhatsApp Alerts ──────────────────────────────────────────
WA_ALERTS_PORT=8014
WA_PROVIDER=evolution             # evolution | meta
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=tu_api_key_evolution
EVOLUTION_INSTANCE=noc
META_WA_TOKEN=                    # Solo si usas WhatsApp Cloud API
META_PHONE_NUMBER_ID=
WA_NOC_RECIPIENTS=5219991234567,5219997654321   # números con código país
WA_COOLDOWN_MINUTES=15
WA_MAX_PER_HOUR=6

# ── MikroTik (para registrar routers) ───────────────────────
MIKROTIK_DEFAULT_USERNAME=admin
MIKROTIK_DEFAULT_PASSWORD=tu_pass_mikrotik
MIKROTIK_API_PORT=80              # Puerto REST RouterOS v7

# ── Feature Flags (activar módulos) ─────────────────────────
ENABLE_IPV6=true
ENABLE_BGP_ORCHESTRATOR=true
ENABLE_NOC=true
ENABLE_ZABBIX=false               # activar cuando configures Zabbix
ENABLE_WHATSAPP_ALERTS=false      # activar cuando configures Evolution API
